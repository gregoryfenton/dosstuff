+// Raster interrupt state and port handlers
+RasterState raster_state = { 0, 0, false, false };
+
+static uint8_t raster_low = 0;
+static uint8_t raster_high = 0;
+static uint8_t raster_byte = 0;
+
+static void write_raster_port(io_port_t port,
+                              Bitu val,
+                              [[maybe_unused]] io_width_t width)
+{
+	if (port != RASTER_PORT)
+		return;
+
+	const auto byte = static_cast<uint8_t>(val);
+
+	switch (raster_byte) {
+	case 0:
+		raster_low = byte;
+		raster_byte = 1;
+		break;
+
+	case 1:
+		raster_high = byte;
+		raster_byte = 2;
+		break;
+
+	default:
+		raster_state.target_line =
+				static_cast<uint16_t>(raster_low) |
+				(static_cast<uint16_t>(raster_high) << 8);
+
+		raster_state.interrupt_vector = byte;
+
+		raster_state.enabled =
+				(raster_state.target_line != 0);
+
+		if (!raster_state.enabled)
+			raster_state.pending = false;
+
+		raster_byte = 0;
+		break;
+	}
+}
+
+bool VGA_CheckRasterInterrupt()
{
+	if (!raster_state.pending)
+		return false;
+
+	if (!(reg_flags & FLAG_IF))
+		return false;
+
+	const auto vector = raster_state.interrupt_vector;
+
+	raster_state.pending = false;
+
+	CPU_HW_Interrupt(vector);
+
+	return true;
+}
+
 void VGA_LogInitialization(const char *adapter_name,
                           const char *ram_type,
                           const size_t num_modes)
@@ -348,6 +413,8 @@ void VGA_Init()
 			                ((i & 8) ? 1 << j : 0);
 		}
 	}
+
+	IO_RegisterWriteHandler(0x62, write_raster_port, io_width_t::byte, 1);
 }
 
